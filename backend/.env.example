# --- Core ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ENV=production
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# --- Database (Choose Option A for Neon or Option B for Local/Docker) ---
# Option A: Neon Serverless PostgreSQL (Recommended)
DATABASE_URL=postgresql://neondb_owner:npg_PjB5hiCoZ8Uv@ep-silent-frog-aexr1cp8.c-2.us-east-2.aws.neon.tech/neondb?sslmode=require

# Option B: Individual PostgreSQL Variables
POSTGRES_DB=neondb
POSTGRES_USER=neondb_owner
POSTGRES_PASSWORD=your_neon_password
POSTGRES_HOST=ep-your-pooler-id.region.aws.neon.tech
POSTGRES_PORT=5432
DB_SSL_MODE=require
DB_CONN_MAX_AGE=0

# --- JWT ---
ACCESS_TOKEN_LIFETIME_MIN=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Email (for async notifications) ---
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Sentry (error monitoring, optional) ---
SENTRY_DSN=
